APP_ENV=development
SEED_DEMO=true
DATABASE_URL=postgresql+psycopg://coursepilot:coursepilot@postgres:5432/coursepilot
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=coursepilot_chunks

EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_SEND_DIMENSIONS=false

LLM_PROVIDER=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=6
# Relevance gate for remote embeddings; the hash fallback uses 0.05 internally.
MIN_RETRIEVAL_SCORE=0.45
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
