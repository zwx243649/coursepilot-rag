APP_ENV=development
SEED_DEMO=true
DATABASE_URL=postgresql+psycopg://coursepilot:coursepilot@postgres:5432/coursepilot
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=coursepilot_chunks

EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_ENTRIES=2000
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=30

LLM_PROVIDER=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=20
# Dense + BM25 with RRF fusion. Off by default: measured neutral-to-negative on
# the sample corpus, keep it for corpora with lots of rare terms or IDs.
HYBRID_RETRIEVAL_ENABLED=false
QUERY_REWRITE_ENABLED=true
RERANK_ENABLED=true
RERANK_PROVIDER=dashscope
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
RERANK_MODEL=gte-rerank-v2
RERANK_TIMEOUT_SECONDS=25
RERANK_MAX_RETRIES=2
# Relevance gate for remote embeddings; the hash fallback uses 0.05 internally.
MIN_RETRIEVAL_SCORE=0.45
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
